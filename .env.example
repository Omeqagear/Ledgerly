# Ledgerly — example environment file
# Copy this to .env and fill in your values before running docker compose.

# Application
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Database
POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ledgerly
SPRING_DATASOURCE_USERNAME=ledgerly
SPRING_DATASOURCE_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
SPRING_CACHE_TYPE=redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
